# ==============================================================================
# NYU RESEARCH OFFICE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# NOTE: Never commit sensitive credentials or real secrets into version control.
# Duplicate this file to .env and configure for your local or production environment.

APP_NAME="NYU Research Office"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://research.nyu.edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_STACK=single

# ------------------------------------------------------------------------------
# Database Configuration
# Local Development: sqlite
# Production: mysql or pgsql
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nyu_research_office
DB_USERNAME=nyu_db_user
DB_PASSWORD=your_secure_database_password_here

# ------------------------------------------------------------------------------
# Session, Cache & Queue Settings
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & Sanctum
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=research.nyu.edu,localhost:5173
CORS_ALLOWED_ORIGINS=https://research.nyu.edu,http://localhost:5173

# ------------------------------------------------------------------------------
# Filesystem Storage (Private Institutional Vault)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail Gateway (Transactional Notifications)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply-research@nyu.edu"
MAIL_FROM_NAME="NYU Research Office"
