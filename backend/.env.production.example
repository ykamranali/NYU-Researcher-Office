# ==============================================================================
# NYU RESEARCH OFFICE MANAGEMENT SYSTEM - PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# MANDATORY:
# 1. Generate an application key: php artisan key:generate
# 2. Never enable APP_DEBUG in production (APP_DEBUG=false).
# 3. Use an isolated, dedicated database user with strict privileges.
# 4. Bootstrap initial administrator securely via CLI: php artisan research:bootstrap-admin
# ==============================================================================

APP_NAME="NYU Research Office"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://research.nyu.edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Structured Daily Rotating Audit & Application Logs
LOG_CHANNEL=daily
LOG_LEVEL=notice
LOG_DAILY_DAYS=30

# ------------------------------------------------------------------------------
# Production Enterprise Database (MySQL / PostgreSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nyu_research_office_prod
DB_USERNAME=nyu_research_app
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_SECRET_DATABASE_PASSWORD

# ------------------------------------------------------------------------------
# Hardened Session & Cookie Security
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.nyu.edu
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Database cache & background queue workers
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# CORS, Reverse Proxy & Trusted Hosts
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=research.nyu.edu
CORS_ALLOWED_ORIGINS=https://research.nyu.edu

# ------------------------------------------------------------------------------
# Private Document Storage Vault (Non-Public Storage)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Institutional Email Gateway (SMTP / Amazon SES / SendGrid)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply-research@nyu.edu"
MAIL_FROM_NAME="NYU Office of Research"

# ------------------------------------------------------------------------------
# Institutional External Integrations (Optional / On-Demand)
# ------------------------------------------------------------------------------
# CrossRef / DOI Metadata API
CROSSREF_API_URL=https://api.crossref.org
CROSSREF_MAILTO="research-systems@nyu.edu"

# ORCID Member API
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ENVIRONMENT=production
